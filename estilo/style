:root {
            --bg: #f4f7fb;
            --card: #ffffff;
            --primary: #1f4e79;
            --secondary: #2c6aa0;
            --accent: #dfeaf6;
            --text: #1f2937;
            --muted: #5b6472;
            --line: #d9e2ec;
            --highlight: #f7c948;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #edf3fb 0%, #f9fbff 100%);
            color: var(--text);
        }

        .page {
            max-width: 1100px;
            margin: 40px auto;
            background: var(--card);
            box-shadow: 0 18px 50px rgba(31, 78, 121, 0.12);
            border-radius: 18px;
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: #fff;
            padding: 42px 48px 32px;
        }

        .header-top {
            display: flex;
            justify-content: space-between;
            gap: 24px;
            align-items: center;
            flex-wrap: wrap;
        }

        .profile {
            flex: 1;
        }

        h1 {
            margin: 0;
            font-size: clamp(2.1rem, 3vw, 3rem);
            letter-spacing: 0.5px;
        }

        .role {
            margin: 10px 0 0;
            font-size: 1.1rem;
            opacity: 0.9;
            font-weight: 500;
        }

        .contact {
            display: grid;
            gap: 8px;
            font-size: 0.96rem;
            min-width: 260px;
        }

        .contact span {
            display: flex;
            align-items: center;
            gap: 8px;
            opacity: 0.94;
        }

        .content {
            display: grid;
            grid-template-columns: 0.9fr 1.4fr;
            gap: 0;
        }

        .sidebar,
        .main {
            padding: 28px 32px 20px;
        }

        .sidebar {
            background: #f9fbff;
            border-right: 1px solid var(--line);
        }

        .main {
            background: #fff;
        }

        .section {
            margin-bottom: 26px;
        }

        .section-title {
            margin: 0 0 14px;
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--primary);
            border-bottom: 2px solid var(--accent);
            padding-bottom: 8px;
        }

        .summary {
            font-size: 0.98rem;
            line-height: 1.7;
            color: var(--muted);
            margin: 0;
        }

        .skills {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            padding: 0;
            list-style: none;
        }

        .skills li {
            background: var(--accent);
            color: var(--primary);
            padding: 8px 12px;
            border-radius: 999px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .languages {
            list-style: none;
            padding: 0;
            margin: 0;
            display: grid;
            gap: 10px;
        }

        .languages li {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            color: var(--text);
            font-size: 0.96rem;
        }

        .level {
            width: 120px;
            height: 8px;
            border-radius: 999px;
            background: #e8eef6;
            position: relative;
            overflow: hidden;
        }

        .level::after {
            content: "";
            position: absolute;
            inset: 0;
            width: var(--value);
            background: linear-gradient(90deg, var(--secondary), var(--primary));
            border-radius: inherit;
        }

        .job {
            margin-bottom: 24px;
        }

        .job-header {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 6px;
        }

        .job-title {
            margin: 0;
            font-size: 1.08rem;
            color: var(--text);
        }

        .company {
            color: var(--secondary);
            font-weight: 700;
        }

        .dates {
            color: var(--muted);
            font-size: 0.9rem;
            font-weight: 600;
        }

        .job ul {
            margin: 10px 0 0 18px;
            padding: 0;
            color: var(--muted);
            line-height: 1.7;
        }

        .education-item {
            margin-bottom: 18px;
        }

        .education-item h3 {
            margin: 0 0 4px;
            font-size: 1rem;
        }

        .education-item p {
            margin: 0;
            color: var(--muted);
            line-height: 1.5;
        }

        @media (max-width: 780px) {
            .page {
                margin: 0;
                border-radius: 0;
            }

            .content {
                grid-template-columns: 1fr;
            }

            .sidebar {
                border-right: none;
                border-bottom: 1px solid var(--line);
            }

            .header {
                padding: 28px 22px 24px;
            }

            .sidebar,
            .main {
                padding: 24px 22px;
            }

            .header-top {
                flex-direction: column;
                align-items: flex-start;
            }
        }